<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_task_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/widget_task_check"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="完成任务"
            android:padding="12dp"
            android:src="@drawable/ic_widget_check_empty" />

        <TextView
            android:id="@+id/widget_task_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_task_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/widget_task_expand"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="展开子任务"
            android:padding="11dp"
            android:src="@drawable/ic_expand_more"
            android:tint="@color/widget_on_surface_variant" />

        <ImageButton
            android:id="@+id/widget_task_menu"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="更多任务操作"
            android:padding="11dp"
            android:src="@drawable/ic_widget_more"
            android:tint="@color/widget_on_surface" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_subtask_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="4dp"
        android:paddingStart="34dp" />
</LinearLayout>
